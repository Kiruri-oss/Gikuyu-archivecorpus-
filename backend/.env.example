APP_NAME=Gikuyu Language Archive
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-64-char-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=10080

DATABASE_URL=postgresql+asyncpg://gikuyu:gikuyu@localhost:5432/gikuyu_archive
REDIS_URL=redis://localhost:6379/0

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_AUDIO=gikuyu-audio
S3_BUCKET_TEXT=gikuyu-text
S3_REGION=us-east-1
S3_USE_SSL=false

MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_KEY=masterKey

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

LANGUAGE_DETECTION_THRESHOLD=0.55
MAX_UPLOAD_SIZE_MB=500